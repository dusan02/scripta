generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

// generator client_py {
//   provider             = "prisma-client-py"
//   output               = "../../worker/venv/lib/python3.9/site-packages/prisma"
//   enable_experimental_decimal = true
// }

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String?
  passwordHash     String?
  emailVerified    DateTime?
  role             UserRole        @default(LAWYER)
  orsrExtractType  String          @default("CURRENT") // CURRENT | FULL
  crzDateFrom      DateTime?       // CRZ dátum "od" — null = defaultne 1 rok dozadu
  rozhodnutiaDateFrom DateTime?    // Rozhodnutia dátum "od" — null = defaultne 1 rok dozadu
  vestnikDateFrom  DateTime?       // Vestník dátum "od" — null = defaultne 1 rok dozadu
  defaultSources   String[]        @default([]) // Predvolené registre pre používateľa
  reportLanguage   String          @default("sk") // sk | en | de — jazyk PDF reportu
  attachmentsConfig Json?          // User default: {obchodny_register: true, zivnostensky_register: true, auditorska_sprava: false, uctovna_zavierka_a_poznámky: false}
  tokenVersion     Int             @default(0)
  planName           String?         // Názov paušálu (start, freelance, firma, korporat)
  planRenewalDate    DateTime?       // Dátum obnovenia paušálu
  trialEndsAt        DateTime?       // Koniec skúšobného obdobia (5 zadarmo kreditov na mesiac)
  subscriptionStatus String?         // active | canceled | past_due | trialing
  subscriptionEndsAt DateTime?       // Dátum ukončenia predplatného (pre zrušené)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  // Email bounce/complaint tracking — prevents sending to invalid addresses
  emailBounced       Boolean         @default(false)
  emailBouncedAt     DateTime?
  emailBouncedReason String?
  emailComplained    Boolean         @default(false)
  emailComplainedAt  DateTime?
  // Soft delete — null means active, non-null means deleted (timestamp)
  deletedAt          DateTime?
  reportRequests     ReportRequest[]
  feedback           Feedback[]
  wallet             Wallet?
  creditBatches      CreditBatch[]
  messages           UserMessage[]      @relation("UserMessages")
  sentMessages       UserMessage[]      @relation("SentMessages")
}

model ReportRequest {
  id              String              @id @default(cuid())
  userId          String
  status          ReportStatus        @default(PENDING)
  targetType      TargetType
  ico             String?
  companyName     String?
  selectedSources SourceType[]
  resultUrl       String?
  resultFilePath  String?
  completedAt     DateTime?
  aiStatus        String?
  eta             Int?
  verifaScore     Int?                // Snapshot skóre fixované pri generovaní reportu
  scrapersMs      Int?                // Duration of scraper phase in ms
  aiMs            Int?                // Duration of AI pipeline phase in ms
  auditorMs       Int?                // Duration of Chief Auditor phase in ms
  compileMs       Int?                // Duration of PDF compilation phase in ms
  attachmentsConfig Json?             // Per-report override of attachment visibility
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?           // Soft delete — null means active
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources         ReportSource[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([deletedAt])
}

model ReportSource {
  id              String        @id @default(cuid())
  reportRequestId String
  sourceType      SourceType
  status          SourceStatus  @default(PENDING)
  statusMessage   String?
  filePath        String?
  pageCount       Int?
  findings        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reportRequest   ReportRequest @relation(fields: [reportRequestId], references: [id], onDelete: Cascade)

  @@unique([reportRequestId, sourceType])
  @@index([reportRequestId])
  @@index([sourceType])
  @@index([status])
}

enum UserRole {
  LAWYER
  ADMIN
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
  CANCELLED
}

enum TargetType {
  COMPANY
}

enum SourceType {
  ORSR
  ZRSR
  RPO
  RPVS
  OBCHODNY_VESTNIK
  INSOLVENCY
  POVERENIA
  FINANCNA_SPRAVA
  SP_DLZNICI
  VSZP_DLZNICI
  DOVERA_DLZNICI
  UNION_DLZNICI
  CRRS
  DISKVALIFIKACIE
  NCRZP
  NCRD
  OCHRANNE_ZNAMKY
  FS_DANOVE_SUBJEKTY
  FS_DPH_REGISTROVANI
  FS_DPH_RUSENIE
  FS_DPH_VYMAZANI
  FS_DPH_NADMERNY_ODPOCET
  FS_DPH_BANKOVE_UCTY
  FS_DAN_Z_PRIJMOV
  FS_DAN_PRIJMOV_REG
  REGISTER_UZ
  CRZ
  UVO
  ROZHODNUTIA
}

enum SourceStatus {
  PENDING
  SUCCESS
  FAILED
  UNAVAILABLE
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

enum FeedbackCategory {
  BUG
  IMPROVEMENT
  QUESTION
  OTHER
}

model Feedback {
  id         String          @id @default(cuid())
  userId     String
  category   FeedbackCategory
  requestId  String?
  message    String
  status     String          @default("OPEN") // OPEN | RESOLVED | CLOSED
  reply      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum MessageType {
  ANNOUNCEMENT
  REPLY
  SYSTEM
  USER
}

model UserMessage {
  id         String          @id @default(cuid())
  userId     String?
  senderId   String?
  type        MessageType
  title       String
  body        String
  read        Boolean         @default(false)
  feedbackId  String?
  createdAt   DateTime        @default(now())

  user   User? @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderId])
  @@index([read])
}

model Company {
  ico                 String               @id
  name                String?
  legalForm           String?
  city                String?
  street              String?
  zipCode             String?
  country             String?
  establishedAt       DateTime?
  status              String?
  naceCode            String?
  naceText            String?
  ownershipType       String?              // Druh vlastníctva (súkromné, štátne, zmiešané...)
  sizeCategory        String?              // Veľkosť org. (mikro, malá, stredná, veľká)
  employeeCount       Int?                 // Počet zamestnancov (z RÚZ)
  latestYear          Int?                 // Rok najnovšej závierky (denormalizované pre screener)
  latestRevenue       Decimal?  @db.Decimal(15, 2) // Tržby z najnovšej závierky
  latestProfit        Decimal?  @db.Decimal(15, 2) // Zisk/strata z najnovšej závierky
  latestAssets        Decimal?  @db.Decimal(15, 2) // Aktíva z najnovšej závierky
  latestEquity        Decimal?  @db.Decimal(15, 2) // Vlastné imanie z najnovšej závierky
  financialStatements FinancialStatement[]
  vestnikEvents       VestnikEvent[]
  companyEvents       CompanyEvent[]
  auditVerdict        AuditVerdict?
  companyPersons      CompanyPerson[]

  @@index([legalForm])
  @@index([city])
  @@index([naceCode])
  @@index([status])
  @@index([establishedAt])
  @@index([latestRevenue])
  @@index([latestProfit])
  @@index([latestAssets])
}

model CompanyPerson {
  id          String   @id @default(uuid())
  companyIco  String
  rawName     String
  cleanName   String
  role        String   // "statutar" | "spolocnik"
  city        String?
  zipCode     String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyIco], references: [ico], onDelete: Cascade)

  @@index([companyIco])
  @@index([role])
}

model NaceCode {
  code        String   @id  // SK NACE kód (napr. "49410")
  description String       // Popis (napr. "Cestná doprava osobná")
  section     String?     // Sekcia (A–Q)
  sectionName String?     // Názov sekcie

  @@index([section])
}

model CompanyEvent {
  id           String   @id @default(uuid())
  companyIco   String
  source       String   // ROZHODNUTIA, INSOLVENCY, DISKVALIFIKACIE, DOVERA, VSZP, SP, UNION, FS_DAN, FS_DPH, CRZ, UVO, VESTNIK
  eventType    String   // SUDNE_ROZHODNUTIE, INSOLVENCIA, DISKVALIFIKACIA, POISTOVNA_DLUH, DAN_NEDOPLATOK, VEREJNA_ZMLUVA, OBSTARAVANIE, VESTNIK_UDALOST
  severity     String   // CRITICAL, HIGH, MEDIUM, LOW, INFO
  title        String   // Krátky názov udalosti
  description  String   @db.Text // Detailný popis
  eventDate    DateTime? // Dátum udalosti (ak známy z PDF)
  amount       Decimal? @db.Decimal(15, 2) // Finančná hodnota (napr. výška nedoplatku, suma zmluvy)
  metadata     Json?    // Dodatočné dáta (súd, číslo spisu, IČO protistrany...)
  createdAt    DateTime @default(now())

  company      Company  @relation(fields: [companyIco], references: [ico])

  @@index([companyIco])
  @@index([severity])
  // Dedup: zabraňuje duplicitným eventom s rovnakým zdrojom, typom, dátumom a sumou.
  // eventDate a amount môžu byť NULL — PostgreSQL považuje NULL hodnoty za distinct,
  // takže unikátnosť sa uplatní len pri non-NULL hodnotách.
  @@unique([companyIco, source, eventType, eventDate, amount])
}

model VestnikEvent {
  id              String   @id @default(uuid())
  companyIco      String
  eventType       String   // Konkurz, Exekúcia, Zmena...
  severityLevel   String   // CRITICAL, HIGH, MEDIUM, LOW
  summary         String   @db.Text
  publishedAt     DateTime // Dátum vydania vo vestníku
  sourceId        String?  // Identifikátor z XML feedu (napr. číslo vydania/záznamu)
  createdAt       DateTime @default(now())

  company         Company  @relation(fields: [companyIco], references: [ico])

  @@index([companyIco])
  @@index([severityLevel])
  // Dedup: sourceId je identifikátor z XML feedu (číslo vydania/záznamu).
  // Ak je sourceId NULL (pre staré dáta alebo ručné vloženie), unikátnosť sa neuplatní.
  @@unique([companyIco, sourceId])
}

model FinancialStatement {
  id                                    String          @id @default(uuid())
  companyIco                            String
  year                                  Int
  totalAssets                           Decimal?  @db.Decimal(15, 2)
  currentAssets                         Decimal?  @db.Decimal(15, 2)
  equity                                Decimal?  @db.Decimal(15, 2)
  shortTermLiabilities                  Decimal?  @db.Decimal(15, 2)
  longTermLiabilities                   Decimal?  @db.Decimal(15, 2)        // Dlhodobé záväzky (bankové úvery, dlhopisy...)
  mainActivityRevenue                   Decimal?  @db.Decimal(15, 2)
  grossProfit                           Decimal?  @db.Decimal(15, 2)        // Hrubý zisk (Revenue - COGS) — pre obchodné firmy
  netProfitLoss                         Decimal?  @db.Decimal(15, 2)
  cashAndEquivalents                    Decimal?  @db.Decimal(15, 2)
  operatingCashFlow                     Decimal?  @db.Decimal(15, 2)
  staffCosts                            Decimal?  @db.Decimal(15, 2)        // Osobné náklady
  tradeReceivables                      Decimal?  @db.Decimal(15, 2)        // Pohľadávky z obch. styku
  tradePayables                         Decimal?  @db.Decimal(15, 2)        // Záväzky z obch. styku
  inventory                             Decimal?  @db.Decimal(15, 2)        // Zásoby
  depreciation                          Decimal?  @db.Decimal(15, 2)        // Odpisy dlhodobého nehmotného a hmotného majetku
  investingCashFlow                     Decimal?  @db.Decimal(15, 2)        // Čisté peňažné toky z investičnej činnosti
  financingCashFlow                     Decimal?  @db.Decimal(15, 2)        // Čisté peňažné toky z finančnej činnosti
  interestExpense                       Decimal?  @db.Decimal(15, 2)        // Úroky (náklady na úroky)
  incomeTax                             Decimal?  @db.Decimal(15, 2)        // Daň z príjmov (riadok 60 vo Výkaze)
  employeeCount                         Int?          // Odhadovaný počet zamestnancov
  socialInsuranceLiabilities            Decimal?  @db.Decimal(15, 2)        // Záväzky zo sociálneho poistenia (336A) — trestná zodpovednosť štatutára
  taxLiabilities                        Decimal?  @db.Decimal(15, 2)        // Daňové záväzky a dotácie (341-347) — riziko daňovej exekúcie
  employeeLiabilities                   Decimal?  @db.Decimal(15, 2)        // Záväzky voči zamestnancom (331, 333) — riziko nevyplatených miezd
  currency                              String        @default("EUR") // Mena výkazu (EUR, CZK, USD...)
  statementType                         String        @default("SK_GAAP") // IFRS | SK_GAAP | MICRO
  monthsInPeriod                        Int?          @default(12) // Pre posunuté/kratšie hospodárske roky
  isConsolidated                        Boolean       @default(false)
  createdAt                             DateTime        @default(now())
  
  company                               Company         @relation(fields: [companyIco], references: [ico])
  auditorOpinion                        AuditorOpinion?
  narrativeRisk                         NarrativeRiskAnalysis?
  notesRisk                             NotesRiskAnalysis?

  @@unique([companyIco, year]) // Zabezpečí, že nebudeme mať duplicitné výkazy za jeden rok
}


model AuditorOpinion {
  id                   String             @id @default(uuid())
  financialStatementId String             @unique
  opinionType          String             
  goingConcernRisk     Boolean
  reservationText      String?
  
  statement            FinancialStatement @relation(fields: [financialStatementId], references: [id])
}

model NarrativeRiskAnalysis {
  id                       String             @id @default(uuid())
  financialStatementId     String             @unique
  managementChanges        String?            @db.Text
  litigationRisks          String?            @db.Text
  goingConcernDoubts       Boolean
  plannedInvestments       String?            @db.Text
  profitabilityExplanation String?            @db.Text
  forensicRedFlags         String[]
  synthesis                String             @db.Text
  createdAt                DateTime           @default(now())

  statement                FinancialStatement @relation(fields: [financialStatementId], references: [id])
}

model NotesRiskAnalysis {
  id                      String             @id @default(uuid())
  financialStatementId    String             @unique
  relatedPartyTransactions String?           @db.Text
  offBalanceSheetLiabilities String?         @db.Text
  contingentRisks         String?            @db.Text
  createdAt               DateTime           @default(now())

  statement               FinancialStatement @relation(fields: [financialStatementId], references: [id])
}

model AuditVerdict {
  id              String   @id @default(uuid())
  companyIco      String   @unique
  verifaScore     Int
  riskCategory    String
  debtExposureRating Int?
  finalVerdict    String   @db.Text
  executiveSummary String? @db.Text
  justification   String   @db.Text
  keyRisk         String   @db.Text
  scorecardBreakdown Json?
  llmScoreAdjustment Int? @default(0)
  llmAnalysisStatus String @default("LLM_ANALYZED")
  createdAt       DateTime @default(now())

  company         Company  @relation(fields: [companyIco], references: [ico])
}

model CreditBatch {
  id          String   @id @default(cuid())
  userId      String
  amount      Int      // Pôvodný počet kreditov v batchi
  remaining   Int      // Koľko ostáva k dispozícii
  source      String   // trial | subscription | addon | rollover
  planName    String?
  expiresAt   DateTime // trial=30d, subscription=60d, addon=permanent, rollover=60d
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("EUR")
  version   Int      @default(0) // Optimistic locking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]

  @@index([userId])
}

enum TransactionType {
  CHARGE
  TOPUP
  REFUND
  REFUND_DEDUCTION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  STRIPE
  PADDLE
  MANUAL
}

model WalletTransaction {
  id                   String             @id @default(cuid())
  walletId             String
  amount               Decimal            @db.Decimal(10, 2)
  type                 TransactionType
  status               TransactionStatus  @default(COMPLETED)
  reportRequestId      String?
  provider             PaymentProvider?
  providerReference    String?            @unique
  description          String?
  createdAt            DateTime           @default(now())

  wallet               Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([reportRequestId])
  @@index([provider, providerReference])
  // DB-level idempotency: prevent duplicate CHARGE or REFUND for the same report.
  // Partial unique index — only applies when reportRequestId is not null.
  @@unique([reportRequestId, type])
}

