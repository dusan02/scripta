generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model AdminAuditLog {
  id          String   @id
  adminUserId String
  action      String
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
  @@index([adminUserId, createdAt])
}

model AlertDelivery {
  id        String    @id
  alertId   String
  userId    String
  channel   String
  status    String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([userId, status])
}

model AlertEvent {
  id          String    @id
  companyId   String
  source      String
  eventType   String
  severity    String
  title       String
  description String
  metadata    Json?
  riskScore   Int?
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?
  deletedAt   DateTime?

  @@index([companyId, createdAt])
  @@index([deletedAt])
  @@index([source, eventType])
}

model AuditVerdict {
  id                 String            @id
  companyIco         String            @unique
  verifaScore        Int
  riskCategory       String
  debtExposureRating Int?
  finalVerdict       String
  executiveSummary   String?
  justification      String
  keyRisk            String
  scorecardBreakdown Json?
  createdAt          DateTime          @default(now())
  llmAnalysisStatus  String            @default("LLM_ANALYZED")
  llmScoreAdjustment Int?              @default(0)
  Company            Company           @relation(fields: [companyIco], references: [ico])
  ScoringSnapshot    ScoringSnapshot[]
}

model AuditorOpinion {
  id                   String             @id
  financialStatementId String             @unique
  opinionType          String
  goingConcernRisk     Boolean
  reservationText      String?
  FinancialStatement   FinancialStatement @relation(fields: [financialStatementId], references: [id])
}

model Company {
  ico                String               @id
  name               String?
  naceCode           String?
  naceText           String?
  city               String?
  country            String?
  establishedAt      DateTime?
  legalForm          String?
  status             String?
  street             String?
  zipCode            String?
  employeeCount      Int?
  latestAssets       Decimal?             @db.Decimal(15, 2)
  latestEquity       Decimal?             @db.Decimal(15, 2)
  latestProfit       Decimal?             @db.Decimal(15, 2)
  latestRevenue      Decimal?             @db.Decimal(15, 2)
  latestYear         Int?
  ownershipType      String?
  sizeCategory       String?
  ruzEntityId        Int?
  orsrSyncedAt       DateTime?
  ruzSyncedAt        DateTime?
  updatedAt          DateTime             @default(now())
  AuditVerdict       AuditVerdict?
  CompanyEvent       CompanyEvent[]
  CompanyPerson      CompanyPerson[]
  FinancialStatement FinancialStatement[]
  ScoringSnapshot    ScoringSnapshot[]
  VestnikEvent       VestnikEvent[]

  @@index([city])
  @@index([establishedAt])
  @@index([latestAssets])
  @@index([latestProfit])
  @@index([latestRevenue])
  @@index([legalForm])
  @@index([naceCode])
  @@index([orsrSyncedAt])
  @@index([ruzSyncedAt])
  @@index([status])
}

model CompanyEvent {
  id          String    @id
  companyIco  String
  source      String
  eventType   String
  severity    String
  title       String
  description String
  eventDate   DateTime?
  amount      Decimal?  @db.Decimal(15, 2)
  metadata    Json?
  createdAt   DateTime  @default(now())
  Company     Company   @relation(fields: [companyIco], references: [ico])

  @@index([companyIco])
  @@index([severity])
}

model CompanyPerson {
  id            String    @id
  companyIco    String
  rawName       String
  cleanName     String
  role          String
  city          String?
  zipCode       String?
  createdAt     DateTime  @default(now())
  street        String?
  functionStart DateTime?
  updatedAt     DateTime  @default(now())
  Company       Company   @relation(fields: [companyIco], references: [ico], onDelete: Cascade)

  @@index([companyIco])
  @@index([role])
}

model CreditBatch {
  id        String   @id
  amount    Int
  remaining Int
  source    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  planName  String?
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

model Feedback {
  id        String           @id
  userId    String
  category  FeedbackCategory
  requestId String?
  message   String
  status    String           @default("OPEN")
  reply     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime
  User      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model FinancialStatement {
  id                         String                 @id
  companyIco                 String
  year                       Int
  totalAssets                Decimal?               @db.Decimal(15, 2)
  currentAssets              Decimal?               @db.Decimal(15, 2)
  equity                     Decimal?               @db.Decimal(15, 2)
  shortTermLiabilities       Decimal?               @db.Decimal(15, 2)
  longTermLiabilities        Decimal?               @db.Decimal(15, 2)
  mainActivityRevenue        Decimal?               @db.Decimal(15, 2)
  grossProfit                Decimal?               @db.Decimal(15, 2)
  netProfitLoss              Decimal?               @db.Decimal(15, 2)
  cashAndEquivalents         Decimal?               @db.Decimal(15, 2)
  operatingCashFlow          Decimal?               @db.Decimal(15, 2)
  staffCosts                 Decimal?               @db.Decimal(15, 2)
  tradeReceivables           Decimal?               @db.Decimal(15, 2)
  tradePayables              Decimal?               @db.Decimal(15, 2)
  currency                   String                 @default("EUR")
  statementType              String                 @default("SK_GAAP")
  monthsInPeriod             Int?                   @default(12)
  isConsolidated             Boolean                @default(false)
  createdAt                  DateTime               @default(now())
  depreciation               Decimal?               @db.Decimal(15, 2)
  employeeCount              Int?
  employeeLiabilities        Decimal?               @db.Decimal(15, 2)
  financingCashFlow          Decimal?               @db.Decimal(15, 2)
  interestExpense            Decimal?               @db.Decimal(15, 2)
  inventory                  Decimal?               @db.Decimal(15, 2)
  investingCashFlow          Decimal?               @db.Decimal(15, 2)
  socialInsuranceLiabilities Decimal?               @db.Decimal(15, 2)
  taxLiabilities             Decimal?               @db.Decimal(15, 2)
  incomeTax                  Decimal?               @db.Decimal(15, 2)
  nonCurrentAssets           Decimal?               @db.Decimal(15, 2)
  intangibleAssets           Decimal?               @db.Decimal(15, 2)
  tangibleAssets             Decimal?               @db.Decimal(15, 2)
  ltFinancialAssets          Decimal?               @db.Decimal(15, 2)
  ltReceivables              Decimal?               @db.Decimal(15, 2)
  stFinancialAssets          Decimal?               @db.Decimal(15, 2)
  deferredAssets             Decimal?               @db.Decimal(15, 2)
  shareCapital               Decimal?               @db.Decimal(15, 2)
  sharePremium               Decimal?               @db.Decimal(15, 2)
  otherCapitalFunds          Decimal?               @db.Decimal(15, 2)
  statutoryReserveFunds      Decimal?               @db.Decimal(15, 2)
  otherProfitFunds           Decimal?               @db.Decimal(15, 2)
  retainedEarnings           Decimal?               @db.Decimal(15, 2)
  retainedProfit             Decimal?               @db.Decimal(15, 2)
  accumulatedLoss            Decimal?               @db.Decimal(15, 2)
  currentYearProfit          Decimal?               @db.Decimal(15, 2)
  ltReserves                 Decimal?               @db.Decimal(15, 2)
  stReserves                 Decimal?               @db.Decimal(15, 2)
  stBankLoans                Decimal?               @db.Decimal(15, 2)
  stFinancialAssistance      Decimal?               @db.Decimal(15, 2)
  operatingCosts             Decimal?               @db.Decimal(15, 2)
  materialConsumption        Decimal?               @db.Decimal(15, 2)
  servicesCosts              Decimal?               @db.Decimal(15, 2)
  wageCosts                  Decimal?               @db.Decimal(15, 2)
  taxesFees                  Decimal?               @db.Decimal(15, 2)
  financialResult            Decimal?               @db.Decimal(15, 2)
  profitBeforeTax            Decimal?               @db.Decimal(15, 2)
  profitTransfer             Decimal?               @db.Decimal(15, 2)
  statementDate              String?
  approvalDate               String?
  ruzZavierkaId              Int?
  ruzVykazId                 Int?
  updatedAt                  DateTime               @default(now())
  AuditorOpinion             AuditorOpinion?
  Company                    Company                @relation(fields: [companyIco], references: [ico])
  NarrativeRiskAnalysis      NarrativeRiskAnalysis?
  NotesRiskAnalysis          NotesRiskAnalysis?

  @@unique([companyIco, year])
}

model NaceCode {
  code        String  @id
  description String
  section     String?
  sectionName String?

  @@index([section])
}

model NarrativeRiskAnalysis {
  id                       String             @id
  financialStatementId     String             @unique
  managementChanges        String?
  litigationRisks          String?
  goingConcernDoubts       Boolean
  plannedInvestments       String?
  forensicRedFlags         String[]
  synthesis                String
  createdAt                DateTime           @default(now())
  profitabilityExplanation String?
  FinancialStatement       FinancialStatement @relation(fields: [financialStatementId], references: [id])
}

model NotesRiskAnalysis {
  id                         String             @id
  financialStatementId       String             @unique
  relatedPartyTransactions   String?
  offBalanceSheetLiabilities String?
  contingentRisks            String?
  createdAt                  DateTime           @default(now())
  FinancialStatement         FinancialStatement @relation(fields: [financialStatementId], references: [id])
}

model PasswordResetToken {
  id        String   @id
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model ReportRequest {
  id                String         @id
  userId            String
  status            ReportStatus   @default(PENDING)
  targetType        TargetType
  ico               String?
  selectedSources   SourceType[]
  resultUrl         String?
  resultFilePath    String?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  companyName       String?
  aiStatus          String?
  eta               Int?
  aiMs              Int?
  attachmentsConfig Json?
  auditorMs         Int?
  compileMs         Int?
  scrapersMs        Int?
  verifaScore       Int?
  deletedAt         DateTime?
  User              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReportSource      ReportSource[]

  @@index([deletedAt])
  @@index([status])
  @@index([userId, createdAt])
}

model ReportSource {
  id              String        @id
  reportRequestId String
  sourceType      SourceType
  status          SourceStatus  @default(PENDING)
  statusMessage   String?
  filePath        String?
  pageCount       Int?
  findings        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  ReportRequest   ReportRequest @relation(fields: [reportRequestId], references: [id], onDelete: Cascade)

  @@unique([reportRequestId, sourceType])
  @@index([reportRequestId])
  @@index([sourceType])
  @@index([status])
}

model ScoringSnapshot {
  id                  String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  companyIco          String
  reportRequestId     String?
  scoringVersion      String        @default("v3")
  financialYear       Int?
  baseScore           Int
  finalScore          Int
  riskCategory        String
  adjustmentTotal     Int           @default(0)
  adjustments         Json
  isConsolidated      Boolean       @default(false)
  financialBasis      String        @default("individual")
  llmAdjustment       Int?          @default(0)
  llmAdjustmentReason String?
  whOverrideRefund    Int?          @default(0)
  inputDataHash       String?
  createdAt           DateTime      @default(now())
  auditVerdictId      String?
  AuditVerdict        AuditVerdict? @relation(fields: [auditVerdictId], references: [id], onUpdate: NoAction)
  Company             Company       @relation(fields: [companyIco], references: [ico], onUpdate: NoAction)

  @@index([companyIco])
  @@index([createdAt])
  @@index([scoringVersion])
}

model User {
  id                                     String           @id
  email                                  String           @unique
  name                                   String?
  passwordHash                           String?
  role                                   UserRole         @default(LAWYER)
  createdAt                              DateTime         @default(now())
  updatedAt                              DateTime
  crzDateFrom                            DateTime?
  orsrExtractType                        String           @default("CURRENT")
  tokenVersion                           Int              @default(0)
  defaultSources                         String[]         @default([])
  planName                               String?
  planRenewalDate                        DateTime?
  emailVerified                          DateTime?
  attachmentsConfig                      Json?
  reportLanguage                         String           @default("sk")
  rozhodnutiaDateFrom                    DateTime?
  subscriptionEndsAt                     DateTime?
  subscriptionStatus                     String?
  trialEndsAt                            DateTime?
  vestnikDateFrom                        DateTime?
  emailBounced                           Boolean          @default(false)
  emailBouncedAt                         DateTime?
  emailBouncedReason                     String?
  emailComplained                        Boolean          @default(false)
  emailComplainedAt                      DateTime?
  deletedAt                              DateTime?
  AdminAuditLog                          AdminAuditLog[]
  AlertDelivery                          AlertDelivery[]
  CreditBatch                            CreditBatch[]
  Feedback                               Feedback[]
  ReportRequest                          ReportRequest[]
  UserMessage_UserMessage_senderIdToUser UserMessage[]    @relation("UserMessage_senderIdToUser")
  UserMessage_UserMessage_userIdToUser   UserMessage[]    @relation("UserMessage_userIdToUser")
  Wallet                                 Wallet?
  WatchedCompany                         WatchedCompany[]

  @@index([deletedAt])
}

model UserMessage {
  id                              String      @id
  userId                          String?
  type                            MessageType
  title                           String
  body                            String
  read                            Boolean     @default(false)
  feedbackId                      String?
  createdAt                       DateTime    @default(now())
  senderId                        String?
  deletedAt                       DateTime?
  User_UserMessage_senderIdToUser User?       @relation("UserMessage_senderIdToUser", fields: [senderId], references: [id])
  User_UserMessage_userIdToUser   User?       @relation("UserMessage_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([read])
  @@index([senderId])
  @@index([userId])
}

model VerificationToken {
  id        String   @id
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model VestnikEvent {
  id            String   @id
  companyIco    String
  eventType     String
  severityLevel String
  summary       String
  publishedAt   DateTime
  sourceId      String?
  createdAt     DateTime @default(now())
  Company       Company  @relation(fields: [companyIco], references: [ico])

  @@index([companyIco])
  @@index([severityLevel])
}

model VestnikSyncCheckpoint {
  id               String   @id
  endpoint         String   @unique
  lastId           Int?
  sinceTimestamp   String
  lastRunAt        DateTime @default(now())
  lastRunSuccess   Boolean  @default(false)
  pagesFetched     Int      @default(0)
  eventsFetched    Int      @default(0)
  matchedCompanies Int      @default(0)
  savedEvents      Int      @default(0)
  durationMs       Int      @default(0)
}

model Wallet {
  id                String              @id
  userId            String              @unique
  balance           Decimal             @default(0) @db.Decimal(10, 2)
  currency          String              @default("EUR")
  version           Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  WalletTransaction WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id                String            @id
  walletId          String
  amount            Decimal           @db.Decimal(10, 2)
  type              TransactionType
  status            TransactionStatus @default(COMPLETED)
  reportRequestId   String?
  providerReference String?           @unique
  description       String?
  createdAt         DateTime          @default(now())
  provider          PaymentProvider?
  eventId           String?           @unique
  Wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([provider, providerReference])
  @@index([reportRequestId])
  @@index([walletId])
}

model WatchedCompany {
  id        String    @id
  userId    String
  companyId String
  note      String?   @db.VarChar(500)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  deletedAt DateTime?
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([deletedAt])
  @@index([userId])
}

enum FeedbackCategory {
  BUG
  IMPROVEMENT
  QUESTION
  OTHER
}

enum MessageType {
  ANNOUNCEMENT
  REPLY
  SYSTEM
  USER
}

enum PaymentProvider {
  STRIPE
  PADDLE
  MANUAL
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
  CANCELLED
}

enum SourceStatus {
  PENDING
  SUCCESS
  FAILED
  UNAVAILABLE
}

enum SourceType {
  ORSR
  ZRSR
  RPO
  RPVS
  OBCHODNY_VESTNIK
  INSOLVENCY
  POVERENIA
  FINANCNA_SPRAVA
  SP_DLZNICI
  VSZP_DLZNICI
  DOVERA_DLZNICI
  UNION_DLZNICI
  CRRS
  DISKVALIFIKACIE
  NCRZP
  NCRD
  OCHRANNE_ZNAMKY
  FS_DANOVE_SUBJEKTY
  FS_DPH_REGISTROVANI
  FS_DPH_RUSENIE
  FS_DPH_VYMAZANI
  FS_DPH_NADMERNY_ODPOCET
  FS_DPH_BANKOVE_UCTY
  FS_DAN_Z_PRIJMOV
  FS_DAN_PRIJMOV_REG
  REGISTER_UZ
  CRZ
  UVO
  ROZHODNUTIA
}

enum TargetType {
  COMPANY
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  CHARGE
  TOPUP
  REFUND
  REFUND_DEDUCTION
}

enum UserRole {
  LAWYER
  ADMIN
}
