server {
    server_name verifa.sk;
    # Keeps snippets/junk_filter.conf parity via $verifa_junk_ua + scanner locations
    # without modifying shared conf.d/zz-junk-filter.conf or snippets/junk_filter.conf
    # (other 4 domains on the VPS stay completely untouched).
    if ($verifa_junk_ua) { return 403; }

    # Scanner/WordPress/exploit probe paths → 404 (verbatim from snippets/junk_filter.conf).
    location ~* ^/(wp|wordpress|xmlrpc|vendor/|node_modules/|composer\.|\.env|\.git|\.svn|\.hg|\.bzr|\.aws|\.ssh|\.npm|\.yarn|\.config|\.docker|\.kube|etc/passwd|proc/self) {
        return 404;
    }
    location ~* \.(php[0-9]*|phtml|phar|cgi|pl|asp|aspx|ashx|jsp|do|action|cfm|sql|bak|old|orig|swp|swo|save|tmp|temp|zip|tar|gz|tgz|rar|7z|bz2|xz|exe|dll|msi|sh|bash|bat|cmd|ps1|ini|cfg|conf|env|ya?ml|sqlite|db|dbf|mdb|log|out|err|dump|core|pem|key|crt|der|p12|pfx|jks|keystore|ppk|pub)$ {
        return 404;
    }

    # Keeps snippets/farm_asn_filter.conf parity via $verifa_farm_block (prevents Sunday pmp-farm-asn-map overwrite)
    if ($verifa_farm_block) { return 403; }

    # Zero-value SEO crawlers (~32% of weekly volume) - hard 403 (map in conf.d/zz-verifa-limits.conf)
    if ($seo_bot_ua) { return 403; }

    # Verifa-only crawler & scraper guards (Krok B / Stream 2)
    # Googlebot and signed POST webhooks (/api/billing/webhook, /api/email/*) unaffected.
    if ($verifa_unwanted_bot_ua)    { return 403; }
    if ($verifa_spoofed_browser_ua) { return 403; }
    if ($verifa_bot_rsc_block)      { return 403; }
    if ($verifa_bot_objednat_block) { return 403; }

    # Per-IP HTML page rate limit (assets/API excluded via $verifa_page map) + GPTBot cap
    limit_req zone=verifa_pages  burst=60 nodelay;
    limit_req zone=verifa_gptbot burst=3  nodelay;

    # Crawler observability log (rt = request_time, cache = Next.js ISR status)
    access_log /var/log/nginx/verifa_perf.log verifa_perf;

    client_max_body_size 50M;

    # Dedicated rate limit for NextAuth session polling flood (~23k/day)
    location = /api/auth/session {
        limit_req zone=verifa_auth_session burst=30 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # PDF download — disable buffering for large files (150MB+)
    location ~ ^/api/reports/.+/download$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 0;
    }

    # AI bot rate limits on localized /firma/ paths (Experiment 3b+4)
    # Claude: 1 req/s | Perplexity: 0.5 req/s | Meta-webindexer: 0.5 req/s
    # Meta-external: 1 req/s | Amazon: 2 req/s | Googlebot: NO LIMIT
    location ~ ^/(en|de|cs|hu|pl)/firma/ {
        limit_req zone=perplexity_firma burst=2 nodelay;
        limit_req zone=claude_firma burst=2 nodelay;
        limit_req zone=meta_webindexer_firma burst=2 nodelay;
        limit_req zone=meta_external_firma burst=2 nodelay;
        limit_req zone=amazon_firma burst=2 nodelay;
        limit_req zone=verifa_pages burst=60 nodelay;
        limit_req zone=verifa_gptbot burst=3 nodelay;
        limit_req zone=verifa_bingbot_loc burst=2 nodelay;
        limit_req zone=verifa_exabot burst=3 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 16 16k;
        proxy_max_temp_file_size 50m;
    }

    # AI bot rate limits on /firma/ paths (Experiment 2+3+4)
    # Perplexity: 0.5 req/s | Claude: 1 req/s | Meta-webindexer: 0.5 req/s
    # Meta-external: 1 req/s | Amazon: 2 req/s | Googlebot: NO LIMIT
    location ~ ^/firma/ {
        limit_req zone=perplexity_firma burst=2 nodelay;
        limit_req zone=claude_firma burst=2 nodelay;
        limit_req zone=meta_webindexer_firma burst=2 nodelay;
        limit_req zone=meta_external_firma burst=2 nodelay;
        limit_req zone=amazon_firma burst=2 nodelay;
        limit_req zone=verifa_pages burst=60 nodelay;
        limit_req zone=verifa_gptbot burst=3 nodelay;
        limit_req zone=verifa_bingbot_firma burst=10 nodelay;
        limit_req zone=verifa_exabot burst=3 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 16 16k;
        proxy_max_temp_file_size 50m;
    }

    # Next.js frontend
    # IndexNow key file — served directly (standalone Next does not pick up
    # public files added post-build)
    location = /9141a55f71827fa50be4dda1ffbcc66e.txt {
        alias /var/www/verifa/frontend/public/9141a55f71827fa50be4dda1ffbcc66e.txt;
        default_type text/plain;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 16 16k;
        proxy_max_temp_file_size 50m;
    }
    # Static PDF samples — no upgrade headers
    location /samples/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        add_header Content-Disposition "inline" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Accept-Ranges bytes;
        proxy_read_timeout 300s;
    }
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/verifa.sk/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/verifa.sk/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    # ── Security headers ──
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;


}
server {
    if ($host = www.verifa.sk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = verifa.sk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name verifa.sk;

    # Crawler observability log (rt = request_time, cache = Next.js ISR status)
    access_log /var/log/nginx/verifa_perf.log verifa_perf;
    return 404; # managed by Certbot




}
