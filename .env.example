# ─── Database ──────────────────────────────────────────────
POSTGRES_USER=verifa
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=verifa
DATABASE_URL=postgresql://verifa:change_me_in_production@localhost:5432/verifa
DATABASE_URL_UNPOOLED=postgresql://verifa:change_me_in_production@localhost:5432/verifa

# ─── Auth (REQUIRED — no insecure defaults) ────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
WORKER_SECRET=generate-with-openssl-rand-base64-32
CRON_SECRET=generate-with-openssl-rand-base64-32

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=generate-with-openssl-rand-base64-32

# ─── Upstash Redis REST (rate limiting) ────────────────────
# Optional but recommended for production. Without it, rate limiting
# falls back to in-memory (per-instance, not effective in multi-instance).
# Get credentials at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── OAuth Providers ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure AD — provider not yet implemented in auth.ts
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ─── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PAYG1=
STRIPE_PRICE_PAYG10=
STRIPE_PRICE_PAYG50=
STRIPE_PRICE_FREELANCE=
STRIPE_PRICE_FIRMA=
STRIPE_PRICE_KORPORAT=
STRIPE_PRICE_ADDON5=
STRIPE_TAX_RATE_SK=

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Verifa.sk <noreply@verifa.sk>

# ─── S3 / R2 ───────────────────────────────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Worker ────────────────────────────────────────────────
GEMINI_API_KEY=
CRE_USERNAME=
CRE_PASSWORD=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Browserless ───────────────────────────────────────────
BROWSERLESS_TOKEN=
