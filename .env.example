# ─── Database ──────────────────────────────────────────────
POSTGRES_USER=verifa
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=verifa
DATABASE_URL=postgresql://verifa:change_me_in_production@localhost:5432/verifa
DATABASE_URL_UNPOOLED=postgresql://verifa:change_me_in_production@localhost:5432/verifa

# ─── Auth (REQUIRED — no insecure defaults) ────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
WORKER_SECRET=generate-with-openssl-rand-base64-32
CRON_SECRET=generate-with-openssl-rand-base64-32

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=generate-with-openssl-rand-base64-32

# ─── Upstash Redis REST (rate limiting) ────────────────────
# Optional but recommended for production. Without it, rate limiting
# falls back to in-memory (per-instance, not effective in multi-instance).
# Get credentials at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── OAuth Providers ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure AD — provider not yet implemented in auth.ts
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ─── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PAYG1=
STRIPE_PRICE_PAYG10=
STRIPE_PRICE_PAYG50=
STRIPE_PRICE_FREELANCE=
STRIPE_PRICE_FIRMA=
STRIPE_PRICE_KORPORAT=
STRIPE_PRICE_ADDON5=
STRIPE_TAX_RATE_SK=

# ─── Paddle ────────────────────────────────────────────────
# Set BILLING_PROVIDER=paddle to use Paddle instead of Stripe.
# Sandbox: PADDLE_ENVIRONMENT=sandbox, NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Live:    PADDLE_ENVIRONMENT=production, NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
BILLING_PROVIDER=paddle
PADDLE_API_KEY=pdl_live_apikey_...   # or pdl_sdbx_apikey_... for sandbox
PADDLE_WEBHOOK_SECRET=ntfset_...      # from notification settings
PADDLE_ENVIRONMENT=production         # or sandbox
PADDLE_PRICE_1=pri_...                # 1 credit, one-time
PADDLE_PRICE_10=pri_...               # 10 credits, one-time
PADDLE_PRICE_50=pri_...               # 50 credits, one-time
PADDLE_PRICE_FREELANCE=pri_...        # 5 credits/month subscription
PADDLE_PRICE_FIRMA=pri_...            # 20 credits/month subscription
PADDLE_PRICE_KORPORAT=pri_...         # 40 credits/month subscription
PADDLE_PRICE_ADDON5=pri_...           # 5 credits, one-time addon
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...  # or test_... for sandbox
NEXT_PUBLIC_PADDLE_ENVIRONMENT=production  # or sandbox

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Verifa.sk <noreply@verifa.sk>

# ─── S3 / R2 ───────────────────────────────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Worker ────────────────────────────────────────────────
GEMINI_API_KEY=
CRE_USERNAME=
CRE_PASSWORD=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Browserless ───────────────────────────────────────────
BROWSERLESS_TOKEN=
